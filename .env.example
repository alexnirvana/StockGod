MYSQL_USER=stockgod
MYSQL_PASSWORD=stockgod_local_only
MYSQL_ROOT_PASSWORD=stockgod_root_local_only
MYSQL_DATABASE=stockgod
WEB_PORT=8080
APP_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
COOKIE_SECURE=false
# For an HTTPS domain, set APP_ORIGINS to its exact origin and COOKIE_SECURE=true.
# Local development defaults to SQLite; Compose uses MySQL.
